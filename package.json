{
  "name": "dsh-plugin-orange-pro",
  "version": "0.4.1",
  "description": "DeepSeek Harness plugin for the Orange Pro (New API) relay: account login, group-key model catalog, OpenAI-compatible chat route, image/video generation tools, and vision image input.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/vision.test.mjs && node test/adapter.test.mjs && node test/media.test.mjs && node test/plugin-smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ft54482/dsh-plugin-orange-pro.git"
  },
  "homepage": "https://github.com/ft54482/dsh-plugin-orange-pro#readme",
  "bugs": {
    "url": "https://github.com/ft54482/dsh-plugin-orange-pro/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "new-api",
    "relay",
    "llm",
    "orange-pro",
    "vision",
    "image-generation",
    "video-generation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
