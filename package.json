{
  "name": "chengzipro-dsh-plugin",
  "version": "0.4.7",
  "description": "橙子PRO中转站（https://pro.nat6.net）DSH 插件：登录即用全部模型；国产模型满精度/满上下文/满缓存的正品折扣渠道；DeepSeek V4.1 最新版、2.5 折、缓存率 95%+、官 Key 非号池。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/vision.test.mjs && node test/adapter.test.mjs && node test/media.test.mjs && node test/plugin-smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ft54482/chengzipro-dsh-plugin.git"
  },
  "homepage": "https://github.com/ft54482/chengzipro-dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/ft54482/chengzipro-dsh-plugin/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "new-api",
    "relay",
    "llm",
    "orange-pro",
    "vision",
    "image-generation",
    "video-generation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
